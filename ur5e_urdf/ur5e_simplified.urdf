<?xml version="1.0"?>
<!--
  UR5e 简化单文件 URDF（不依赖 xacro / ROS 工具链 / 外部 mesh 文件）

  数据来源：UniversalRobots/Universal_Robots_ROS2_Description (rolling)
    - config/ur5e/default_kinematics.yaml  关节间变换（origin）
    - config/ur5e/joint_limits.yaml        关节限位（limit）
    - config/ur5e/physical_parameters.yaml 质量/质心/惯量（inertial）
  说明：
    - 运动学、限位、惯性均为官方精确数值；visual/collision 用原始几何体近似官方 mesh
    - 关节转轴统一为局部 z 轴（axis="0 0 1"），方向由 origin 的 rpy 表达（官方新版约定）
    - 保留 base_link_inertia（官方为兼容 MoveIt 等运动学求解器而拆分根 link 惯性）
-->
<robot name="ur5e_simplified" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ 材质 ============ -->
  <material name="light_gray">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <!-- ============ links ============ -->

  <!-- 根 link：纯坐标系，不带惯性（MoveIt 兼容） -->
  <link name="base_link"/>

  <!-- 底座（承载 visual/collision/inertial） -->
  <link name="base_link_inertia">
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- 圆柱近似：radius=0.06 length=0.05, m=4 -->
      <inertia ixx="0.008033" ixy="0" ixz="0" iyy="0.008033" iyz="0" izz="0.0072"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <inertial>
      <mass value="3.761"/>
      <origin xyz="0.0 -0.00193 -0.02561" rpy="1.570796326794897 0 0"/>
      <inertia ixx="0.00700210" ixy="0.00000073" ixz="-0.00001053"
               iyy="0.00648091" iyz="0.00049994" izz="0.00657286"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.12"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.06" length="0.12"/></geometry>
    </collision>
  </link>

  <link name="upper_arm_link">
    <inertial>
      <mass value="8.058"/>
      <origin xyz="-0.2125 0 0.11336" rpy="0 0 0"/>
      <inertia ixx="0.01505885" ixy="-0.00005400" ixz="0.00000563"
               iyy="0.33388086" iyz="-0.00000181" izz="0.33247207"/>
    </inertial>
    <visual>
      <!-- 沿 x 轴的长臂（rpy 绕 y 转 90° 使圆柱轴向 x） -->
      <origin xyz="0 0 0.138" rpy="0 1.570796326794897 0"/>
      <geometry><cylinder radius="0.05" length="0.46"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.138" rpy="0 1.570796326794897 0"/>
      <geometry><cylinder radius="0.05" length="0.46"/></geometry>
    </collision>
  </link>

  <link name="forearm_link">
    <inertial>
      <mass value="2.846"/>
      <origin xyz="-0.2422 0 0.0265" rpy="0 0 0"/>
      <inertia ixx="0.00399632" ixy="-0.00001365" ixz="0.00137272"
               iyy="0.07879254" iyz="-0.00000660" izz="0.07848510"/>
    </inertial>
    <visual>
      <origin xyz="-0.19 0 0.007" rpy="0 1.570796326794897 0"/>
      <geometry><cylinder radius="0.04" length="0.4"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="-0.19 0 0.007" rpy="0 1.570796326794897 0"/>
      <geometry><cylinder radius="0.04" length="0.4"/></geometry>
    </collision>
  </link>

  <link name="wrist_1_link">
    <inertial>
      <mass value="1.37"/>
      <origin xyz="0 -0.01634 -0.0018" rpy="1.570796326794897 0 0"/>
      <inertia ixx="0.00165491" ixy="-0.00000282" ixz="-0.00000438"
               iyy="0.00135962" iyz="0.00010157" izz="0.00126279"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.127" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.07"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.127" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.07"/></geometry>
    </collision>
  </link>

  <link name="wrist_2_link">
    <inertial>
      <mass value="1.3"/>
      <origin xyz="0 0.01634 -0.0018" rpy="-1.570796326794897 0 0"/>
      <inertia ixx="0.00135617" ixy="-0.00000274" ixz="0.00000444"
               iyy="0.00127827" iyz="-0.00005048" izz="0.00096614"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0997" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.08"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0997" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.08"/></geometry>
    </collision>
  </link>

  <link name="wrist_3_link">
    <inertial>
      <mass value="0.365"/>
      <origin xyz="0 0 -0.001159" rpy="0 0 0"/>
      <inertia ixx="0.00018694" ixy="0.00000006" ixz="-0.00000017"
               iyy="0.00018908" iyz="-0.00000092" izz="0.00025756"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.1"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.1"/></geometry>
    </collision>
  </link>

  <!-- ============ joints ============ -->

  <joint name="base_link-base_link_inertia" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
  </joint>

  <joint name="shoulder_pan_joint" type="revolute">
    <origin xyz="0 0 0.1625" rpy="0 0 0"/>
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586"
           effort="150.0" velocity="3.141592653589793"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <origin xyz="0 0 0" rpy="1.570796326794897 0 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586"
           effort="150.0" velocity="3.141592653589793"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <origin xyz="-0.425 0 0" rpy="0 0 0"/>
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <axis xyz="0 0 1"/>
    <!-- 官方将 elbow 限位人为限制为 ±180°（物理上受 shoulder_lift 干涉，且利于 MoveIt 规划） -->
    <limit lower="-3.141592653589793" upper="3.141592653589793"
           effort="150.0" velocity="3.141592653589793"/>
  </joint>

  <joint name="wrist_1_joint" type="revolute">
    <origin xyz="-0.3922 0 0.1333" rpy="0 0 0"/>
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586"
           effort="28.0" velocity="3.141592653589793"/>
  </joint>

  <joint name="wrist_2_joint" type="revolute">
    <origin xyz="0 -0.0997 0" rpy="1.570796326794897 0 0"/>
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586"
           effort="28.0" velocity="3.141592653589793"/>
  </joint>

  <joint name="wrist_3_joint" type="revolute">
    <origin xyz="0 0.0996 0" rpy="1.570796326589793 3.141592653589793 3.141592653589793"/>
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586"
           effort="28.0" velocity="3.141592653589793"/>
  </joint>

</robot>
